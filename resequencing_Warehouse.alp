			<Name><![CDATA[Main]]></Name>
			<AdditionalClassCode><![CDATA[// Parameters 
double parkingSpaceCost = 15000;
double bodyDowntimeCostPerHour = 400000;
String dataFolder ="C:/Users/admin/Desktop/simulation_anylogic/";

// Variables
ArrayList<Vehicle> allVehicles = new ArrayList<Vehicle>();

HashMap<String, Vehicle> vehiclesByVin = new HashMap<String, Vehicle>();

ArrayList<Vehicle> bodyExitEvents = new ArrayList<Vehicle>();

ArrayList<Vehicle> warehouse = new ArrayList<Vehicle>();


ArrayList<Vehicle> blockedAtBodyShop = new ArrayList<Vehicle>();

int nextBodyExitIndex = 0;

int nextPaintRequestIndex = 0;

int paintedCount = 0;

// KPIs
int blockedVehicleCount = 0;

int paintStarvedCount = 0;

double bodyBlockedStartTime = -1;

double bodyBlockedMinutes = 0;

double capexCost = 0;

double bodyDowntimeCost = 0;

double totalCost = 0;

//validation
int resequencingActions = 0;]]></AdditionalClassCode>
			<Import><![CDATA[import java.io.*;
import java.text.*;
import java.util.*;
]]></Import>
			<StartupCode><![CDATA[// 1) load planned orders (need VIN + plannedGlobalSeq)
for (HashMap<String,String> row : readCsv("01_production_orders_planned.csv")) {
    Vehicle v = new Vehicle();
    v.vin = row.get("VIN");
    try { v.plannedGlobalSeq = Integer.parseInt(row.get("planned_global_sequence")); }
    catch (Exception e) { v.plannedGlobalSeq = 0; }
    allVehicles.add(v);
    vehiclesByVin.put(v.vin, v);
}

// 2) attach body exit times
for (HashMap<String,String> row : readCsv("02_bodyshop_output_actual.csv")) {
    Vehicle v = vehiclesByVin.get(row.get("VIN"));
    if (v == null) continue;
    v.bodyExitDate = parseDate(row.get("body_exit_time"));
    if (v.bodyExitDate != null) bodyExitEvents.add(v);
}

// 3) attach paint timings; build paint-request timestamp list
for (HashMap<String,String> row : readCsv("03_paintshop_input_actual.csv")) {
    Vehicle v = vehiclesByVin.get(row.get("VIN"));
    if (v == null) continue;
    try { v.paintProcMin       = Double.parseDouble(row.get("paint_proc_min")); }       catch (Exception e) {}
    try { v.paintChangeoverMin = Double.parseDouble(row.get("paint_changeover_min")); } catch (Exception e) {}
    try { v.paintQualityHoldMin= Double.parseDouble(row.get("paint_quality_hold_min"));} catch (Exception e) {}
   
}

// 4) sort events chronologically
bodyExitEvents.sort((a,b) -> a.bodyExitDate.compareTo(b.bodyExitDate));


traceln("Loaded: orders=" + allVehicles.size()
      + " bodyExits=" + bodyExitEvents.size()
      );

// 5) kick off the first body exit and the first paint request
if (!bodyExitEvents.isEmpty()) {
    evBodyExit.restart(Math.max(0,
        minutesFromStart(bodyExitEvents.get(0).bodyExitDate) - time()));
}

updateCosts();]]></StartupCode>
			<DestroyCode><![CDATA[// Close any still-open blocking window
if (bodyBlockedStartTime >= 0) {
    bodyBlockedMinutes += time() - bodyBlockedStartTime;
    bodyBlockedStartTime = -1;
}
updateCosts();]]></DestroyCode>
