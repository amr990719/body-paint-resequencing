						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (nextBodyExitIndex >= bodyExitEvents.size()) return;
Vehicle v = bodyExitEvents.get(nextBodyExitIndex);
nextBodyExitIndex++;
onBodyExit(v);

if (nextBodyExitIndex < bodyExitEvents.size()) {
    Vehicle next = bodyExitEvents.get(nextBodyExitIndex);
    double dt = minutesFromStart(next.bodyExitDate) - time();
    evBodyExit.restart(Math.max(0, dt));
}]]></Action>
				</Event>
