			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ArrayList<HashMap<String,String>>]]></ReturnType>
					<Id>1778856881900</Id>
					<Name><![CDATA[readCsv]]></Name>
					<Description><![CDATA[Read a CSV file and convert each row into usable Java data structures.]]></Description>
					<X>80</X><Y>20</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[fileName]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[ArrayList<HashMap<String,String>> rows = new ArrayList<>();
try {
    BufferedReader br = new BufferedReader(new FileReader(dataFolder + fileName));
      
    // Read header row
    String headerLine = br.readLine();
    if (headerLine == null) { br.close(); return rows; }
    String[] headers = headerLine.replace("\uFEFF","").split(",", -1);
    String line;
    
    // Read data rows
    while ((line = br.readLine()) != null) {
        String[] values = line.split(",", -1);
        HashMap<String,String> row = new HashMap<>();
        for (int i = 0; i < headers.length; i++) {
            row.put(headers[i].trim(), i < values.length ? values[i].trim() : "");
        }
        rows.add(row);
    }
    br.close();
} catch (Exception e) {
    traceln("CSV error: " + fileName + " → " + e.getMessage());
}
return rows;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Date]]></ReturnType>
					<Id>1778857234204</Id>
					<Name><![CDATA[parseDate]]></Name>
					<Description><![CDATA[Convert a text/string date from CSV into a real Java Date object.]]></Description>
					<X>80</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[s]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (s == null || s.trim().isEmpty()) return null;
String[] patterns = {
    "M/d/yyyy H:mm", "M/d/yyyy HH:mm",
    "yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd HH:mm", "yyyy-MM-dd"
};
for (String p : patterns) {
    try { return new SimpleDateFormat(p).parse(s.trim()); } catch (Exception e) {}
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778857330147</Id>
					<Name><![CDATA[minutesFromStart]]></Name>
					<Description><![CDATA[Convert a real Date into simulation time in minutes measured from the simulation start date.

#So this function translates :
from <Real calendar time>
into<Simulation time in minutes>]]></Description>
					<X>80</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[d]]></Name>
						<Type><![CDATA[Date]]></Type>
					</Parameter>
					<Body><![CDATA[return (d.getTime() - getEngine().getStartDate().getTime()) / 60000.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Vehicle]]></ReturnType>
					<Id>1778858019642</Id>
					<Name><![CDATA[selectVehicleForPaint]]></Name>
					<Description><![CDATA[This is the resequencing brain — pick the vehicle in the warehouse with the smallest plannedGlobalSeq]]></Description>
					<X>80</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (warehouse.isEmpty()) {
    paintStarvedCount++;
    return null;
}
Vehicle best = warehouse.get(0);
for (Vehicle v : warehouse) {
    if (v.plannedGlobalSeq < best.plannedGlobalSeq) best = v;
}

Vehicle oldest = warehouse.get(0);
for (Vehicle v : warehouse) {
    if (v.warehouseEnterTime < oldest.warehouseEnterTime) oldest = v;
}
if (best != oldest) resequencingActions++;
return best;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778858206670</Id>
					<Name><![CDATA[onBodyExit]]></Name>
					<Description><![CDATA[ Handles the event of a vehicle exiting the Body Shop.
 
If warehouse space is available, the vehicle is transferred to the warehouse buffer and its warehouse entry time is recorded.

If the warehouse is full, the vehicle becomes blocked at the Body Shop, is added to the blocked queue.]]></Description>
					<X>80</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[v]]></Name>
						<Type><![CDATA[Vehicle]]></Type>
					</Parameter>
					<Body><![CDATA[if (warehouse.size() < warehouseCapacity) {
    v.warehouseEnterTime = time();
    warehouse.add(v);
    releaseToPaint();
} else {
    v.wasBlocked = true;
    blockedVehicleCount++;
    blockedAtBodyShop.add(v);
    if (bodyBlockedStartTime < 0) bodyBlockedStartTime = time();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778858871673</Id>
					<Name><![CDATA[releaseToPaint]]></Name>
					<Description><![CDATA[Selects the next available vehicle for Paint Shop processing.
 
 If no vehicle is available in the warehouse, the function exits without processing.

When a vehicle is selected:
  - It is removed from the warehouse buffer.

  - The system checks whether a blocked vehicle from the Body Shop can now be admitted into the warehouse due to the newly freed space.

  - The selected vehicle is then transferred to the Paint Shop entrance process.
 ]]></Description>
					<X>80</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (delayPaint.size() > 0) return;
Vehicle v = selectVehicleForPaint();
if (v == null) return;
warehouse.remove(v);
admitBlockedVehicleIfPossible();
enterPaint.take(v);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778858918510</Id>
					<Name><![CDATA[admitBlockedVehicleIfPossible]]></Name>
					<Description><![CDATA[Attempts to admit a previously blocked vehicle from the Body Shop into the warehouse when storage space becomes available.
The function first checks:
 - Whether there are any blocked vehicles waiting.
 - Whether the warehouse currently has available capacity.
  
If an active body blocking period exists, the blocking duration is updated and the blocking timer is cleared because at least one blocked vehicle can now move forward.
 
The first blocked vehicle in the queue is then:
 - Removed from the blocked list.
 - Assigned a warehouse entry time.
 - Added into the warehouse buffer.
 
 Finally, if blocked vehicles still remain and the warehouse becomes full again immediately after admission, a new blocking period is started.]]></Description>
					<X>80</X><Y>240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (blockedAtBodyShop.isEmpty()) return;
if (warehouse.size() >= warehouseCapacity) return;

if (bodyBlockedStartTime >= 0) {
    bodyBlockedMinutes += time() - bodyBlockedStartTime;
    bodyBlockedStartTime = -1;
}
Vehicle v = blockedAtBodyShop.remove(0);
v.warehouseEnterTime = time();
warehouse.add(v);
if (!blockedAtBodyShop.isEmpty() && warehouse.size() >= warehouseCapacity) {
    bodyBlockedStartTime = time();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778859258452</Id>
					<Name><![CDATA[updateCosts]]></Name>
					<X>80</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[capexCost = warehouseCapacity * parkingSpaceCost;
// close any open blocking window for live KPI display
double liveBlocked = bodyBlockedMinutes;
if (bodyBlockedStartTime >= 0) liveBlocked += time() - bodyBlockedStartTime;
bodyDowntimeCost = (liveBlocked / 60.0) * bodyDowntimeCostPerHour;
totalCost = capexCost + bodyDowntimeCost;]]></Body>
				</Function>
			</Functions>
